# Ambiente da aplicação: development | test | production
NODE_ENV=development

# Porta do servidor HTTP
PORT=3333

# String de conexão com o MongoDB (obrigatório)
MONGODB_URI=mongodb://localhost:27017/genesis

# Segredo para assinatura dos tokens JWT (mínimo de 32 caracteres)
JWT_SECRET=troque-por-um-segredo-com-minimo-32-chars-hex-ou-rand

# Chave de API pública para validação de requisições da vitrine (mínimo de 24 caracteres)
# IMPORTANTE: Deve ser idêntica à VITE_PUBLIC_API_KEY do frontend
PUBLIC_API_KEY=troque-pela-chave-publica-da-vitrine-24+

# Política SameSite para cookies de autenticação (opcional: lax | strict | none)
# Em desenvolvimento: lax. Em produção com domínios diferentes: none
COOKIE_SAME_SITE=lax

# Origens permitidas para requisições CORS e validação CSRF (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
