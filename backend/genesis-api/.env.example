NODE_ENV=development
PORT=3333
# Local: postgresql://user:senha@127.0.0.1:5432/genesis
# Neon (produção/Vercel): use a connection string "pooled" do painel da Neon,
# que já inclui "-pooler" no host e "sslmode=require" na query string.
DATABASE_URL=postgresql://127.0.0.1:5432/genesis
JWT_SECRET=troque-por-uma-string-aleatoria-com-no-minimo-32-caracteres
PUBLIC_API_KEY=troque-pela-chave-publica-da-vitrine-24+
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# strict | lax | none. Padrão: none em produção (front em outro domínio), lax em desenvolvimento
# COOKIE_SAME_SITE=strict
